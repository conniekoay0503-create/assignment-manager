# Copy to .env.local and fill in. Never commit real values.
# Production values are set in the Vercel project settings, not in files.

# Supabase (Phase 3) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...), or the legacy service_role key. Server only:
# never prefix with NEXT_PUBLIC_. Not used yet; needed for scheduled jobs from Phase 6.
SUPABASE_SECRET_KEY=

# Public address of the site, used in email links. Leave empty locally.
NEXT_PUBLIC_SITE_URL=
# Set to true after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google OAuth + Calendar (Phase 9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 32-byte key, base64. Encrypts stored Google refresh tokens.
TOKEN_ENCRYPTION_KEY=

# AI document analysis (Phase 8)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Background reminders (Phase 6): shared secret for the scheduled job endpoint
CRON_SECRET=
